

macos-option-as-alt = true

#ttheme = Atom
# theme = UltraDark

# Using Quick Terminal causes ‘Automatically hide and show the Dock’ to be enabled #8739
# https://github.com/ghostty-org/ghostty/discussions/8739
quick-terminal-position = center


keybind = global:option+backquote=toggle_quick_terminal

# Unbind the default "edit settings" keybinding
# Instead this is configured with hammerspoon to launch
# helix in a new ghostty window
keybind = super+,=unbind
