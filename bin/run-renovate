#!/usr/bin/env bash

set -eu

pushd "$(mktemp -d)"

export RENOVATE_TOKEN
RENOVATE_TOKEN=$(gh auth token)

export RENOVATE_CONFIG_FILE="${HOME}/.config/renovate/config.js"
export LOG_LEVEL=debug
# echo which npx
# which npx
fnm exec --using default npx renovate --version
fnm exec --using default npx renovate "$@"
